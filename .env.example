# .env.example を .env にコピーして値を埋める。.env は Git にコミットされない。

# --- Google（専用 Gmail アカウントで認可する） ---
GOOGLE_OAUTH_CLIENT_FILE=.secrets/client_secret.json
GOOGLE_TOKEN_FILE=.secrets/token.json
# メインアカウントのカレンダー ID（通常はメインの Gmail アドレス）。専用 Gmail に共有しておく。
GOOGLE_CALENDAR_ID=your-main-account@gmail.com
# 転送元の大学メールアドレス（転送の確認に使う）
UNIVERSITY_MAIL_ADDRESS=12abc345@ms.dendai.ac.jp

# --- Claude API ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# --- 通知（discord か line） ---
NOTIFY_CHANNEL=discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- サーバー（ローカルで go run ./cmd/server -once ... を試すときに使う。Cloud Run では deploy.sh が設定する） ---
GOOGLE_CLOUD_PROJECT=
GMAIL_PUBSUB_TOPIC=projects/<プロジェクトID>/topics/gmail-push
RETENTION_DAYS=90
